{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "@cs2-analyst/demoparser-native#build": { "cache": false },
    "@cs2-analyst/demoparser-native#typecheck": { "cache": false },
    "@cs2-analyst/desktop#build": { "dependsOn": ["^build"], "cache": false, "outputs": ["dist/**"] },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ELECTRON_*", "electron_*", "npm_config_*"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ELECTRON_*", "electron_*", "npm_config_*"]
    },
    "test:smoke": {
      "cache": false,
      "passThroughEnv": ["ELECTRON_*", "electron_*", "npm_config_*"]
    },
    "test:installed": {
      "cache": false,
      "passThroughEnv": ["ELECTRON_*", "electron_*", "npm_config_*", "CS2_ANALYST_*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
